# Vorlage. Kopiere diese Datei nach .env und trage dort deinen Schlüssel ein.
# .env wird von git ignoriert und verlässt deinen Rechner nicht.
# Gib den Inhalt niemals in einem Chat, einem Ticket oder einer Cloud weiter.
#
# Den Schlüssel erzeugst du selbst: Kraken > Settings > API > Add key.
# Aktiviere ausschliesslich lesende Rechte:
#   Query Funds
#   Query Open Orders and Trades
#   Query Closed Orders and Trades
#   Query Ledger Entries
# Aktiviere NICHT:
#   Create and Modify Orders
#   Cancel/Close Orders
#   Withdraw Funds
#   Margin Trading
# Der Client in moneai/kraken_private.py kann ohnehin nur lesende Endpunkte
# aufrufen. Die Rechtevergabe bei Kraken ist die zweite, wichtigere Sperre.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Voreinstellungen für den lokalen Lauf
MONEAI_PAIR=XBTUSD
MONEAI_INTERVAL=60
MONEAI_START_CASH=1000
